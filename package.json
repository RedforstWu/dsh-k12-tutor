{
  "name": "dsh-k12-tutor",
  "version": "1.0.2",
  "description": "面向中小学生的学习导师（首个学科包：初中数学·人教版）。先诊断再讲解，逐级提示，不代写不代考；未成年人安全、学术诚信和隐私规则常驻。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.2 <0.3",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.2 <0.3"
  },
  "exports": {
    "./k12-tutor": "./ops/k12-tutor.mjs",
    "./package.json": "./package.json",
    ".": "./ops/bundle.mjs",
    "./client": "./client.js"
  },
  "files": [
    "cordis.patch.yml",
    "profile.patch.yml",
    "README.md",
    "LICENSE",
    "SOURCES.md",
    "ops",
    "engine",
    "skills",
    "subjects",
    "activities",
    "packages",
    "themes",
    "characters",
    "client.js",
    "bin",
    "third_party"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
